 "rumors": [
  {
   "mark": "nhan",
   "at": 4,
   "text": "Ngoài đường ai cũng kể làng này có bếp lửa lúc nào cũng còn phần cho người lạ."
  },
  {
   "mark": "uy",
   "at": 4,
   "text": "Mấy người Rìu Đá bảo đừng đụng tới làng này."
  },
  {
   "mark": "lo",
   "at": 4,
   "text": "Có kẻ đếm kho lương của mình từ bên kia suối."
  },
  {
   "mark": "tin",
   "at": -2,
   "below": true,
   "text": "Thương lái đồn làng mình nói một đằng làm một nẻo."
  },
  {
   "mark": "hop",
   "at": 5,
   "text": "Bữa tối giờ không ai phân biệt đâu là người cũ, đâu là người mới."
  },
  {
   "mark": "luat",
   "at": 4,
   "text": "Người làng khác tới nhờ làng mình phân xử: họ bảo ở đây có lệ rõ ràng."
  },
  {
   "mark": "cua",
   "at": 4,
   "text": "Thương lái đi đường vòng cũng ghé: họ bảo kho làng này chưa bao giờ trống."
  },
  {
